# .gitignore del proyecto final de Programacion Genetica (implementaciones A, B y C)
# Va en la raiz del repositorio. Las reglas sin "/" al inicio aplican en todas las
# subcarpetas, asi que un solo archivo cubre los tres programas.

# ---------------------------------------------------------------------------
# Visual Studio y CMake (B y C en C++)
# ---------------------------------------------------------------------------
.vs/
out/
build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
.ninja_deps
.ninja_log
build.ninja

# Proyectos .vcxproj (carpetas de compilacion y configuracion personal)
x64/
x86/
[Dd]ebug/
[Rr]elease/
[Rr]elease[Ww]ith[Dd]eb[Ii]nfo/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
ipch/

# Binarios y archivos intermedios de MSVC, GCC y Clang
*.exe
*.dll
*.lib
*.a
*.so
*.dylib
*.obj
*.o
*.pdb
*.ilk
*.idb
*.exp
*.iobj
*.ipdb
*.pch
*.tlog
*.lastbuildstate
*.recipe
*.dt.d.json
*.dt.module.json
*.dt.module.json.command
gp_b
gp_c
cross_check

# Perfilado (PGO, VTune, perf)
*.pgc
*.pgd
perf.data*
*.vtune

# ---------------------------------------------------------------------------
# A (lenguaje de alto nivel; cubre Python, que es lo mas comun)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
*.egg-info/
.python-version

# ---------------------------------------------------------------------------
# Editores y sistema operativo
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# Respaldos y temporales
*.bak
*.tmp
*.orig
respaldo_*/

# ---------------------------------------------------------------------------
# Resultados de benchmarks
# ---------------------------------------------------------------------------
# Las carpetas resultados_* que crea correr_benchmarks.ps1 no se suben.
resultados_*/
